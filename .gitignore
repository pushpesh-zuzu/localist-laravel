# PHPUnit / Testing
# --------------------------------
/.phpunit.cache
.phpunit.result.cache

# --------------------------------
# IDE & Editor junk
# --------------------------------
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json

# --------------------------------
# Node / Frontend
# --------------------------------
npm-debug.log
yarn-error.log

